   "source": [
    "import numpy as np\n",
    "def f(x1):\n",
    "    return 1-np.exp(-x1)\n",
    "\n",
    "def ff(x1):\n",
    "    return np.log(f(x1))*f(x1)\n",
    "\n",
    "def s(x1):\n",
    "    dx = x1[1]-x1[0]\n",
    "\n",
    "    s = 0\n",
    "    for i in range(0,len(x1)):\n",
    "        s+= ff(x1[i])*dx\n",
    "    print(s)\n"
   ]
  },
